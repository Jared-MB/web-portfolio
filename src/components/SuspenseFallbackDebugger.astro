---
import { Image } from "astro:assets";
---

<article class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
  <aside class="rounded-md bg-background w-fit p-2 h-fit">
    <Image
      src={"/favicon.svg"}
      alt="Suspense Fallback Debugger logo"
      width={48}
      height={48}
      class="rounded-md aspect-square object-contain"
    />
  </aside>
  <div class="flex-1">
    <header class="flex items-center gap-2">
      <h3 class="text-lg sm:text-xl font-medium text-balance grid">
        <span>Maintainer at</span>
        <strong class="font-bold text-xl sm:text-2xl hover:underline">
          <a
            href="https://www.suspense-fallback-debugger.com/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Suspense Fallback Debugger
          </a>
        </strong>
      </h3>
    </header>
    <p class="text-gray-600 text-sm mb-2">
      by
      <a
        href="https://github.com/Jared-MB"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:underline"
      >
        @jared-mb
      </a>
    </p>
    <p class="opacity-70">October 2025</p>
  </div>
</article>
