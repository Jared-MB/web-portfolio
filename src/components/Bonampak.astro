---
import { Image } from "astro:assets";
---

<article class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
    <aside class="rounded-md bg-background w-fit p-2 h-fit">
        <Image
            src="/gst.avif"
            alt="GST logo"
            width={48}
            height={48}
            class="rounded-md aspect-square object-contain"
        />
    </aside>
    <div class="flex flex-col gap-y-2">
        <header>
            <h3 class="text-xl font-medium text-balance">
                Full Stack Freelancer at
                <strong class="font-bold text-2xl hover:underline">
                    <a
                        href="https://www.gsttransportes.com/"
                        target="_blank"
                        rel="noopener noreferrer">Transportes Bonampak</a
                    >
                </strong>
            </h3>
        </header>
        <p class="opacity-70">July 2025 - September 2025</p>
    </div>
</article>
