---
import { Image } from "astro:assets";
---

<article class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
  <aside class="rounded-md bg-background w-fit p-2 h-fit">
    <Image
      src="/cruz-roja.avif"
      alt="Cruz Roja Mexicana"
      width={48}
      height={48}
      class="rounded-md aspect-square object-contain"
    />
  </aside>
  <div class="flex-1">
    <header class="flex items-center gap-2">
      <h3 class="text-xl font-medium text-balance grid">
        <span>Maintainer at</span>
        <strong class="font-bold text-2xl hover:underline">
          <a
            href="https://plasma-docs-six.vercel.app/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Plasma
          </a>
        </strong>
      </h3>
    </header>
    <p class="text-gray-600 text-sm mb-2">
      by
      <a
        href="https://github.com/Cruz-Roja-sistemas/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:underline"
      >
        @CruzRojaMexicana
      </a>
    </p>
    <p class="opacity-70">Present</p>
  </div>
</article>
