---
import Document from "../components/svg/Document.astro";
import Github from "../components/svg/Github.astro";
---

<section
  id="presentation"
  class="relative lg:sticky lg:top-0 max-w-5xl z-0 px-8 py-24 lg:py-0 gap-y-12 lg:gap-y-0 lg:px-0 mx-auto lg:h-dvh flex flex-col lg:flex-row items-start justify-center lg:justify-between lg:items-center"
>
  <article class="flex flex-col gap-y-4">
    <h1
      class="text-[clamp(3rem,13vw,8rem)] leading-[1.05] font-semibold text-balance"
    >
      I'm Jared <br />Muñoz.
    </h1>
    <p class="max-w-xl text-lg sm:text-xl lg:text-2xl">
      <strong>Design Engineer & DX.</strong> Building products people love to use,
      and developers want to work with.
    </p>
  </article>
  <aside
    class="self-end lg:self-auto flex flex-col items-end gap-x-8 gap-y-8 mr-6 lg:mr-0"
  >
    <a
      href="https://jared-mb.kristall.app/Jared%20Mu%C3%B1oz%20-%20CV.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="relative group"
    >
      <div
        id="cv-back"
        class="grid place-content-center overflow-hidden text-background -z-10 rounded-full bg-accent-foreground w-fit px-8 h-14 absolute border border-background right-0"
      >
        <span class="mr-10">Curriculum</span>
      </div>
      <div class="bg-background rounded-full h-14 w-fit">
        <div
          class="bg-background group-hover:bg-accent/40 rounded-full p-2 group-hover:text-accent-foreground transition-colors duration-300 inline-block"
        >
          <Document class="w-10 h-10" />
        </div>
      </div>
    </a>
    <a
      href="https://github.com/Jared-MB"
      target="_blank"
      rel="noopener noreferrer"
      class="relative group"
    >
      <div
        id="github-back"
        class="grid place-content-center overflow-hidden text-background -z-10 rounded-full bg-accent-foreground w-fit px-8 h-14 absolute border border-background right-0"
      >
        <span class="mr-10">Github</span>
      </div>
      <div class="bg-background rounded-full h-14 w-fit">
        <div
          id="github-button"
          class="bg-background group-hover:bg-accent/40 rounded-full p-2 group-hover:text-accent-foreground transition-colors duration-300 inline-block"
        >
          <Github class="w-10 h-10" />
        </div>
      </div>
    </a>
  </aside>
</section>
